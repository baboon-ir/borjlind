---
layout: base.njk
bodyClass: ""
mainClass: "rb-main-full"
noHeader: true
noFooter: true
---
{# Segment metadata for scroll TOC/year state #}
<script type="application/json" id="rb-segment-data">{{ collections.biografiSegments | segmentsMeta | json | safe }}</script>

<div class="rb-bio-reader-wrap">
  <div class="rb-bio-container">
    {% for segment in collections.biografiSegments %}
      <div class="rb-segment" id="segment-{{ segment.id }}" data-segment-id="{{ segment.id }}">
        {% if segment.id == 0 %}
          <section class="rb-cover-page" aria-label="Omslagssida">
            <h1 class="rb-cover-title">bit den hand<br>som föder dig</h1>
            <p class="rb-cover-author">Rolf Börjlind</p>
          </section>
        {% endif %}
        {% for page in segment.pages %}
          <span id="{{ page.anchor }}" class="rb-page-anchor" data-page-number="{{ page.number }}" aria-hidden="true"></span>
          {% if page.item and page.item.templateContent %}
            <div class="rb-page-prose{% if page.mediaPage %} rb-page-prose--media{% endif %}">
              {{ page.item.templateContent | bioRender | safe }}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% endfor %}
  </div>

  <div class="rb-reader-bar">
    <span class="rb-reader-title">bit den hand som föder dig</span>
    <span class="rb-page-indicator" data-footer-center></span>
    <button class="rb-year-toggle rb-reader-nav" data-year-toggle aria-label="Öppna innehållsförteckning">Innehåll</button>
  </div>
</div>

{% include "bio-toc.njk" %}

<script>document.body.dataset.biography = '1';</script>
