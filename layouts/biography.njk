---
layout: base.njk
bodyClass: ""
mainClass: "rb-main-full"
---
{# NAV-02: bake year groups into HTML at build time — no runtime fetch #}
<script type="application/json" id="rb-year-groups">{{ collections.yearGroupMap | json | safe }}</script>

<div class="rb-bio-reader-wrap">
  <section class="rb-title-block">
    <div class="rb-title-author">Rolf Börjlind</div>
    <div class="rb-hero-title">bit den hand <br>som föder dig</div>
  </section>

  {% include "bio-controls.njk" %}

  {# TECH-01: data-total exposes TOTAL_PAGES to bio-reader.js #}
  <div class="rb-bio-container" data-bio-pages data-total="{{ TOTAL_PAGES }}">
    {% for p in collections.biografiAll %}
      {% set page = p %}
      {% include "bio-page.njk" %}
    {% endfor %}
  </div>
</div>

{% include "bio-toc.njk" %}

<script>document.body.dataset.biography = '1';</script>
