---
layout: base.njk
mainClass: "rb-main-full"
noHeader: true
noFooter: true
---
{% set tocItems = [
  { id: "60-talet", label: "60-talet" },
  { id: "70-talet", label: "70-talet" },
  { id: "80-talet", label: "80-talet" },
  { id: "90-talet", label: "90-talet" },
  { id: "00-talet", label: "00-talet" },
  { id: "10-talet", label: "10-talet" },
  { id: "20-talet", label: "20-talet" },
  { id: "bocker", label: "Böcker" },
  { id: "konst", label: "Konst" },
  { id: "forestallningar", label: "Föreställningar" },
  { id: "tv", label: "Tv" },
  { id: "radio", label: "Radio" },
  { id: "biofilmer", label: "Biofilmer" },
  { id: "scen", label: "Scen" },
  { id: "musik", label: "Musik" },
  { id: "tidningar", label: "Tidningar/Tidskrifter" },
  { id: "ovrigt", label: "Övrigt" },
  { id: "utmarkelser", label: "Utmärkelser" }
] %}

<div class="rb-section-reader-wrap">
  <div class="rb-section-container">
    <div class="rb-page-title-wrap">
      <h1 class="rb-page-h1">{{ title }}</h1>
      {% if description %}<p class="rb-page-desc">{{ description }}</p>{% endif %}
    </div>
    <div class="rb-page-content">
      <div class="appendix-content">
        {{ content | safe }}
      </div>
    </div>
  </div>

  <div class="rb-reader-bar">
    <button class="rb-reader-bar-btn" data-site-nav-open aria-label="Öppna meny">Meny</button>
    <span class="rb-reader-title">Appendix</span>
    <button class="rb-reader-bar-btn rb-reader-nav" data-section-toc-open aria-label="Öppna innehållsförteckning">Innehåll</button>
  </div>
</div>

{% include "section-toc.njk" %}
{% include "site-nav.njk" %}

<script>document.body.dataset.sectionReader = '1';</script>
