---
layout: base.njk
bodyClass: rb-hub-bg
mainClass: "h-full"
---
<div class="rb-hub-pattern"></div>
<video class="rb-hub-video" autoplay muted loop playsinline>
  <source src="https://www.rolfborjlind.com/vid/bongo.mp4" type="video/mp4">
</video>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    var v = document.querySelector('.rb-hub-video');
    if (!v) return;
    v.muted = true;
    v.play().catch(function () {
      document.addEventListener('touchstart', function once() {
        v.play();
        document.removeEventListener('touchstart', once);
      });
    });

    var btn = document.querySelector('[data-video-toggle]');
    if (btn) {
      btn.addEventListener('click', function () {
        var active = document.body.classList.toggle('rb-video-active');
        v.muted = !active;
        btn.innerHTML = active ? 'TILLBAKA' : '&#9654; BONGO!';
      });
    }
  });
</script>
<div class="rb-hub-overlay"></div>

<section class="rb-hero">
  <div class="rb-hero-inner">
    <h1 class="rb-hero-title">
      bit den hand<br>som föder dig
    </h1>

    <div class="rb-cta-wrap">
      <a class="rb-cta" href="/biografi/">Läs biografin</a>
    </div>
  </div>
</section>

<button class="rb-video-toggle" data-video-toggle aria-label="Visa video">&#9654; BONGO!</button>

{% include "site-nav.njk" %}
