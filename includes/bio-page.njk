{# expects: page (object with data.page, data.anchor, templateContent) #}
{% set pageNum = page.data.page.number or page.data.pageNum or page.data.pageNumber %}
<section id="{{ page.data.anchor }}" data-page="{{ pageNum }}" class="rb-bio-page">
  <div class="rb-page-meta">
    <div class="rb-page-meta-text">Page {{ pageNum }}/276</div>
    <a class="rb-page-meta-text" href="#{{ page.data.anchor }}">#{{ page.data.anchor }}</a>
  </div>

  {% if (page.templateContent or "") | trim %}
    <div class="rb-prose">
      {{ page.templateContent | bioRender | safe }}
    </div>
  {% else %}
    <div class="rb-page-placeholder">(Demo saknar innehåll för den här sidan.)</div>
  {% endif %}
</section>
 