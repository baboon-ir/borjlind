{# Multi-level sidebar navigation — slides in from right #}
<div class="rb-site-nav" data-site-nav aria-hidden="true">
  <div class="rb-site-nav-backdrop" data-site-nav-backdrop></div>
  <div class="rb-site-nav-content">

    {# ── Level 1: Main site navigation ── #}
    <div class="rb-site-nav-level" data-nav-level="main">
      <div class="rb-site-nav-header">
        <span class="rb-site-nav-title">Meny</span>
        <button class="rb-site-nav-close" data-site-nav-close aria-label="Stäng meny">&#10005;</button>
      </div>
      <ul class="rb-site-nav-list">
        <li><a class="rb-site-nav-link" href="/">Hem</a></li>
        <li><button class="rb-site-nav-link rb-site-nav-drill" data-nav-goto="biografi">Biografi<span class="rb-site-nav-arrow">›</span></button></li>
        <li><button class="rb-site-nav-link rb-site-nav-drill" data-nav-goto="minnen">Minnen<span class="rb-site-nav-arrow">›</span></button></li>
        <li><button class="rb-site-nav-link rb-site-nav-drill" data-nav-goto="appendix">Appendix<span class="rb-site-nav-arrow">›</span></button></li>
      </ul>
    </div>

    {# ── Level 2: Biografi — chapters grouped by year ── #}
    <div class="rb-site-nav-level" data-nav-level="biografi" hidden>
      <div class="rb-site-nav-header">
        <button class="rb-site-nav-back" data-nav-back aria-label="Tillbaka">‹</button>
        <span class="rb-site-nav-title">Biografi</span>
        <button class="rb-site-nav-close" data-site-nav-close aria-label="Stäng meny">&#10005;</button>
      </div>
      <div class="rb-site-nav-scroll">
        <ul class="rb-site-nav-list">
          <li><a class="rb-site-nav-link rb-site-nav-chapter" href="/biografi/#p-001" data-nav-page="1">Framsida</a></li>
        </ul>
        {% for group in navBioData %}
        <div class="rb-site-nav-group">
          <div class="rb-site-nav-group-label">{{ group.yearGroup }}</div>
          <ul class="rb-site-nav-list">
            {% for ch in group.chapters %}
            <li><a class="rb-site-nav-link rb-site-nav-chapter" href="/biografi/#p-{{ ch.startPage | pad3 }}" data-nav-page="{{ ch.startPage }}" data-chapter-id="{{ ch.id }}">{{ ch.title }}</a></li>
            {% endfor %}
          </ul>
        </div>
        {% endfor %}
      </div>
    </div>

    {# ── Level 2: Minnen ── #}
    <div class="rb-site-nav-level" data-nav-level="minnen" hidden>
      <div class="rb-site-nav-header">
        <button class="rb-site-nav-back" data-nav-back aria-label="Tillbaka">‹</button>
        <span class="rb-site-nav-title">Minnen</span>
        <button class="rb-site-nav-close" data-site-nav-close aria-label="Stäng meny">&#10005;</button>
      </div>
      <div class="rb-site-nav-scroll">
        <ul class="rb-site-nav-list">
          <li><a class="rb-site-nav-link" href="/minnen/#kusinen">Kusinen</a></li>
          <li><a class="rb-site-nav-link" href="/minnen/#den-osynlige">Den osynlige</a></li>
          <li><a class="rb-site-nav-link" href="/minnen/#yngling">En vacker yngling</a></li>
        </ul>
      </div>
    </div>

    {# ── Level 2: Appendix ── #}
    <div class="rb-site-nav-level" data-nav-level="appendix" hidden>
      <div class="rb-site-nav-header">
        <button class="rb-site-nav-back" data-nav-back aria-label="Tillbaka">‹</button>
        <span class="rb-site-nav-title">Appendix</span>
        <button class="rb-site-nav-close" data-site-nav-close aria-label="Stäng meny">&#10005;</button>
      </div>
      <div class="rb-site-nav-scroll">
        <ul class="rb-site-nav-list">
          <li><a class="rb-site-nav-link" href="/appendix/#60-talet">60-talet</a></li>
          <li><a class="rb-site-nav-link" href="/appendix/#70-talet">70-talet</a></li>
