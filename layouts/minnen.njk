---
layout: base.njk
mainClass: "rb-main-full"
noHeader: true
noFooter: true
---
{% set tocItems = [
  { id: "kusinen", label: "Kusinen" },
  { id: "den-osynlige", label: "Den osynlige" },
  { id: "yngling", label: "En vacker yngling" }
] %}

<div class="rb-section-reader-wrap">
  <div class="rb-section-container">
    <div class="rb-page-title-wrap">
      <h1 class="rb-page-h1">{{ title }}</h1>
      {% if description %}<p class="rb-page-desc">{{ description }}</p>{% endif %}
    </div>
    <div class="rb-page-content">
      <div class="appendix-content memories text-center">
        {{ content | safe }}
      </div>
    </div>
  </div>

  <div class="rb-reader-bar">
    <button class="rb-reader-bar-btn" data-site-nav-open aria-label="Öppna meny">Meny</button>
    <span class="rb-reader-title">Minnen</span>
    <button class="rb-reader-bar-btn rb-reader-nav" data-section-toc-open aria-label="Öppna innehållsförteckning">Innehåll</button>
  </div>
</div>

{% include "section-toc.njk" %}
{% include "site-nav.njk" %}

<script>document.body.dataset.sectionReader = '1';</script>
