<!doctype html>
<html lang="sv">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, interactive-widget=resizes-visual" />
    {% if ogTitle %}
      {% set pageTitle = ogTitle %}
    {% elif title %}
      {% set pageTitle = "Rolf Börjlind: " + title %}
    {% else %}
      {% set pageTitle = "Rolf Börjlind" %}
    {% endif %}
    {% set pageDesc = description or teaser or "Rolf Sigvard Börjlind, född 7 oktober 1943 i Västra Skrävlinge församling i Malmö, är en svensk poet, skådespelare, regissör, romanförfattare och manusförfattare. Börjlind är mest känd för filmerna om Jönssonligan samt filmerna om Martin Beck som gjordes 1997–2007." %}
    {% set siteUrl = site.url or "https://borjlind.se" %}
    <title>{{ pageTitle }}</title>
    <meta name="description" content="{{ pageDesc }}" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="{{ pageTitle }}" />
    <meta property="og:description" content="{{ pageDesc }}" />
    <meta property="og:image" content="https://pub-511c9170c3a84a38827fa0aaa81fbdc9.r2.dev/og-image.png" />
    <meta property="og:url" content="{{ siteUrl }}{{ page.url }}" />
    <meta property="og:locale" content="sv_SE" />
    <meta property="og:site_name" content="Rolf Börjlind" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="{{ pageTitle }}" />
    <meta name="twitter:description" content="{{ pageDesc }}" />
    <meta name="twitter:image" content="https://pub-511c9170c3a84a38827fa0aaa81fbdc9.r2.dev/og-image.png" />

    <link rel="icon" type="image/png" sizes="32x32" href="/assets/images/fav.png" />
    <link rel="shortcut icon" href="/assets/images/fav.png" />
    <link rel="apple-touch-icon" href="/assets/images/fav.png" />
    <link rel="stylesheet" href="/assets/css/main.css" />
  </head>
  <body class="rb-body {{ bodyClass }}">
    {% if not noHeader %}{% include "header.njk" %}{% endif %}

    <main class="rb-main{% if mainClass == 'h-full' %} rb-main-centered{% endif %}">
      <div class="{% if mainClass == 'h-full' %}{% elif mainClass %}{{ mainClass }}{% else %}rb-main-inner{% endif %}">
        {{ content | safe }}
      </div>
    </main>

    {% if not noFooter %}
    <footer class="rb-mt-auto relative z-10">
      {% include "footer.njk" %}
    </footer>
    {% endif %}

    <script src="/assets/js/nav.js" defer></script>
    <script src="/assets/js/bio-reader.js" defer></script>
    <script src="/assets/js/section-reader.js" defer></script>
  </body>
</html>
